<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Header (brand yellow, same as Trip History) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_xl"
        android:background="@color/colorPrimary">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_earnings"
            app:tint="@color/on_brand"
            android:layout_marginEnd="@dimen/space_md"
            android:importantForAccessibility="no" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/earnings_title"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:textColor="@color/on_brand" />
    </LinearLayout>

    <!-- Period rows -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm">

        <!-- Today -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_item_min_height">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/earnings_today"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/earnTodayMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 trips · 0.0 km"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/earnTodayValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fare_primary"
                android:fontFamily="monospace"
                android:layout_marginStart="@dimen/space_md"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:importantForAccessibility="no" />

        <!-- Last 7 days -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_item_min_height">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/earnings_week"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/earnWeekMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 trips · 0.0 km"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/earnWeekValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fare_primary"
                android:fontFamily="monospace"
                android:layout_marginStart="@dimen/space_md"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:importantForAccessibility="no" />

        <!-- Last 30 days -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:minHeight="@dimen/list_item_min_height">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/earnings_month"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/earnMonthMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 trips · 0.0 km"
                    android:textSize="@dimen/text_caption"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <TextView
                android:id="@+id/earnMonthValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/fare_primary"
                android:fontFamily="monospace"
                android:layout_marginStart="@dimen/space_md"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_color"
        android:importantForAccessibility="no" />

    <!-- Simple 7-day bar visualization (plain views, no chart library) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/earnings_chart_caption"
        android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginTop="@dimen/space_lg" />

    <LinearLayout
        android:id="@+id/earningsChartContainer"
        android:layout_width="match_parent"
        android:layout_height="128dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:contentDescription="@string/cd_earnings_chart" />

    <TextView
        android:id="@+id/earningsEmptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/earnings_empty_hint"
        android:textAppearance="@style/TextAppearance.TaxiMeter.Caption"
        android:gravity="center"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:visibility="gone" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/space_md">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:importantForAccessibility="no" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeEarningsButton"
            style="@style/Widget.TaxiMeter.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_target"
            android:text="@string/close"
            android:textColor="@color/colorAccent"
            android:contentDescription="@string/cd_close_earnings" />
    </LinearLayout>

</LinearLayout>
