<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".MainActivity">

    <!-- Map -->
    <com.google.android.gms.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ Top HUD: status · time · distance · speed ═══ -->
    <LinearLayout
        android:id="@+id/topStatusBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/simple_card_background"
        android:paddingStart="@dimen/space_md"
        android:paddingEnd="@dimen/space_md"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginTop="@dimen/space_md"
        android:elevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusIndicator"
                    android:layout_width="@dimen/status_dot_size"
                    android:layout_height="@dimen/status_dot_size"
                    android:background="@drawable/status_dot"
                    android:backgroundTint="@color/status_available"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_available"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_status"
                android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="@color/divider_color"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />

        <!-- Time -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/timeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textAppearance="@style/TextAppearance.TaxiMeter.Metric"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_time"
                android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="@color/divider_color"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />

        <!-- Distance -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/distanceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textAppearance="@style/TextAppearance.TaxiMeter.Metric"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_km"
                android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="32dp"
            android:background="@color/divider_color"
            android:layout_gravity="center_vertical"
            android:importantForAccessibility="no" />

        <!-- Speed -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/speedTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textAppearance="@style/TextAppearance.TaxiMeter.Metric"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_speed"
                android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Map tap hint ═══ -->
    <TextView
        android:id="@+id/mapHintText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tap_map_pickup"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/colorWhite"
        android:background="@drawable/hint_background"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintTop_toBottomOf="@+id/topStatusBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/space_sm" />

    <!-- ═══ Right-side FAB stack (48dp targets) ═══ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/locationFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:src="@drawable/ic_my_location"
        android:contentDescription="@string/cd_my_location"
        app:backgroundTint="@color/surface"
        app:tint="@color/colorAccent"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/fab_icon_size"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/historyFab"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/historyFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:src="@drawable/ic_history"
        android:contentDescription="@string/cd_trip_history"
        app:backgroundTint="@color/surface"
        app:tint="@color/text_primary"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/fab_icon_size"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/pickupFab"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/pickupFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_md"
        android:src="@drawable/ic_my_location"
        android:contentDescription="@string/cd_set_pickup"
        app:backgroundTint="@color/colorAccent"
        app:tint="@color/colorWhite"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/fab_icon_size"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/destinationFab"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/destinationFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_lg"
        android:src="@drawable/ic_flag_finish"
        android:contentDescription="@string/cd_set_destination"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/on_brand"
        app:fabCustomSize="@dimen/fab_size"
        app:maxImageSize="@dimen/fab_icon_size"
        app:borderWidth="0dp"
        app:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomContainer"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══ Bottom sheet: fare + controls ═══ -->
    <LinearLayout
        android:id="@+id/bottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bottom_card_background"
        android:paddingStart="@dimen/space_xl"
        android:paddingEnd="@dimen/space_xl"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_lg"
        android:elevation="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fare row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_lg">

            <!-- Country flag (opens tariff picker) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/countryButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:minWidth="@dimen/touch_target"
                android:minHeight="@dimen/touch_target"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="🇲🇦"
                android:textSize="24sp"
                android:padding="0dp"
                android:contentDescription="@string/cd_country_flag"
                app:iconSize="0dp"
                tools:ignore="HardcodedText" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/space_xs">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fare"
                    android:textAppearance="@style/TextAppearance.TaxiMeter.MetricLabel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/currencyButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="36dp"
                    android:text="@string/currency"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorAccent"
                    android:contentDescription="@string/cd_country_flag"
                    android:paddingStart="0dp"
                    android:paddingEnd="@dimen/space_sm"
                    app:icon="@drawable/ic_currency"
                    app:iconSize="14dp"
                    app:iconTint="@color/colorAccent"
                    app:iconPadding="4dp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <!-- Big fare readout -->
            <TextView
                android:id="@+id/fareTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textAppearance="@style/TextAppearance.TaxiMeter.FareDisplay"
                android:includeFontPadding="false"
                android:contentDescription="@string/cd_fare_amount"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/currencyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DH"
                android:textColor="@color/text_secondary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="6dp"
                android:gravity="bottom"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Primary controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/space_sm">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/startRideButton"
                style="@style/Widget.TaxiMeter.Button"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_primary"
                android:layout_weight="3"
                android:text="@string/start_ride"
                android:textSize="16sp"
                android:textColor="@color/colorWhite"
                app:backgroundTint="@color/button_start"
                app:cornerRadius="@dimen/radius_pill"
                android:layout_marginEnd="@dimen/space_md"
                android:elevation="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pauseButton"
                style="@style/Widget.TaxiMeter.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_primary"
                android:layout_weight="1"
                android:contentDescription="@string/cd_pause_resume"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/text_primary"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeColor="@color/button_secondary"
                android:layout_marginEnd="@dimen/space_sm"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                style="@style/Widget.TaxiMeter.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height_primary"
                android:layout_weight="1"
                android:contentDescription="@string/cd_reset"
                app:icon="@drawable/ic_clear"
                app:iconTint="@color/colorError"
                app:iconSize="24dp"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="@dimen/radius_pill"
                app:strokeColor="@color/colorError" />
        </LinearLayout>

        <!-- Secondary row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Keep-screen-on toggle: active only while metering -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/keepScreenOnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/keep_screen_on"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:contentDescription="@string/cd_keep_screen_on" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/earningsButton"
                style="@style/Widget.TaxiMeter.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/earnings_button"
                android:textSize="13sp"
                android:contentDescription="@string/cd_earnings"
                app:icon="@drawable/ic_earnings"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary"
                app:iconPadding="6dp"
                android:layout_marginEnd="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                style="@style/Widget.TaxiMeter.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_target"
                android:text="@string/tariff_settings"
                android:textSize="13sp"
                android:contentDescription="@string/cd_settings"
                app:icon="@drawable/ic_settings"
                app:iconSize="18dp"
                app:iconTint="@color/text_secondary"
                app:iconPadding="6dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ Trip summary overlay ═══ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/tripSummaryCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_lg"
        android:layout_marginEnd="@dimen/space_lg"
        android:visibility="gone"
        app:cardElevation="16dp"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardBackgroundColor="@color/surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_2xl">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/trip_summary"
                android:textAppearance="@style/TextAppearance.TaxiMeter.Title"
                android:gravity="center"
                android:layout_marginBottom="@dimen/space_xs" />

            <View
                android:layout_width="48dp"
                android:layout_height="3dp"
                android:background="@color/colorPrimary"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/space_xl"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/summaryContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/space_xl" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shareTripButton"
                    style="@style/Widget.TaxiMeter.Button.Outlined"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/share"
                    android:contentDescription="@string/cd_share_trip"
                    app:icon="@drawable/ic_share"
                    app:iconSize="18dp"
                    app:iconTint="@color/colorAccent"
                    app:iconPadding="6dp"
                    app:cornerRadius="@dimen/radius_lg"
                    app:strokeColor="@color/colorAccent"
                    android:textColor="@color/colorAccent"
                    android:layout_marginEnd="@dimen/space_sm" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/closeSummaryButton"
                    style="@style/Widget.TaxiMeter.Button"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height"
                    android:layout_weight="1"
                    android:text="@string/close"
                    android:textColor="@color/on_brand"
                    android:contentDescription="@string/cd_close_summary"
                    app:backgroundTint="@color/colorPrimary"
                    app:cornerRadius="@dimen/radius_lg"
                    android:layout_marginStart="@dimen/space_sm" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
