    <!-- ─── UI utility ─── -->
    <color name="divider_color">#34383E</color>
    <color name="fab_background">#8AB4F8</color>

    <!-- ─── Dialog & info ─── -->
    <color name="info_background_color">#1B2735</color>
    <color name="info_border_color">#2C3E55</color>
    <color name="example_background_color">#332B00</color>
