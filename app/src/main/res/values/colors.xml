    <color name="text_primary">#191C1E</color>
    <color name="text_secondary">#545B62</color>
    <color name="text_hint">#8A9199</color>
    <color name="primaryTextColor">#FFFFFF</color>
    <color name="hintTextColor">#8A9199</color>

    <!-- ─── Fare display (glanceable meter readout) ─── -->
    <color name="fare_display">#101214</color>            <!-- Near-black number in daylight -->
    <color name="fare_primary">#B7860B</color>            <!-- Legacy: darkened brand for text use -->
    <color name="fare_secondary">#545B62</color>

    <!-- ─── Ride status ─── -->
    <color name="status_available">#1E8E3E</color>        <!-- Green -->
