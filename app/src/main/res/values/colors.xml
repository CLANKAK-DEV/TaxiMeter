<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ════════════════════════════════════════════════════════════════════
         TaxiMeter Design System — "Checker" palette (light values)
         Brand: classic taxi yellow on near-black, high-contrast neutrals.
         Every semantic token below has a dark counterpart in
         values-night/colors.xml. Legacy names are kept for compatibility.
         ════════════════════════════════════════════════════════════════════ -->

    <!-- ─── Brand ─── -->
    <color name="colorPrimary">#FFD700</color>            <!-- Taxi yellow -->
    <color name="colorPrimaryDark">#F5B800</color>        <!-- Deep yellow -->
    <color name="colorPrimaryVariant">#FFC107</color>
    <color name="on_brand">#1F1B00</color>                <!-- Text/icons on yellow (15.2:1) -->
    <color name="brand_container">#FFF3C4</color>
    <color name="on_brand_container">#241A00</color>
    <color name="colorAccent">#0B57D0</color>             <!-- Info blue (6.4:1 on white) -->

    <!-- ─── Neutrals / surfaces ─── -->
    <color name="app_background">#F4F5F7</color>
    <color name="surface">#FFFFFF</color>
    <color name="surface_elevated">#FFFFFF</color>
    <color name="on_surface">#191C1E</color>              <!-- 16.1:1 on surface -->
    <color name="on_surface_variant">#545B62</color>      <!-- 6.9:1 on surface -->
    <color name="outline">#E1E4E8</color>
    <color name="scrim">#99000000</color>

    <!-- ─── Basic ─── -->
    <color name="colorWhite">#FFFFFF</color>
    <color name="colorBlack">#000000</color>
    <color name="transparent">#00000000</color>

